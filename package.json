{
  "name": "proconnect-test-client",
  "version": "1.0.0",
  "description": "This is a minimal, nodeJS-based ProConnect client, to be used for end-to-end testing.",
  "homepage": "https://github.com/proconnect-gouv/proconnect-test-client#readme",
  "bugs": {
    "url": "https://github.com/proconnect-gouv/proconnect-test-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proconnect-gouv/proconnect-test-client.git"
  },
  "license": "AGPL-3.0",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "format": "prettier --write .",
    "lint": "oxlint",
    "start": "tsx .",
    "test": "cd e2e && npm run test",
    "test:unit": "tsx --test log.test.ts",
    "typecheck": "tsc --checkers 4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/strictest": "2.0.8",
    "dotenv-flow": "^4.1.0",
    "hono": "^4.13.14",
    "openid-client": "^6.8.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.20.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  }
}
